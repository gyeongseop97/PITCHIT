<script id="pitchit-3d-entry">
(()=>{
 let enabled=false,scene=null,loading=null,stage=null,historyPanel=null,lastNetworkKey='',localSequence=0,loadVersion=0,voice=false;
 let follow=!matchMedia('(prefers-reduced-motion: reduce)').matches;
 let latestRoomHistory=null;const buttons=[];let captionTimer=0,wasPlaying=false;
 let heldScore=null,pendingFeedback=null,pendingPanels=[],localPresentation=null;
 function beginHold(){if(!enabled||!scene)return;if(!heldScore)pendingFeedback=null;document.body.classList.add('pitchit3DPending');if(!heldScore){const score=document.querySelector('.score');if(score){heldScore=score.cloneNode(true);heldScore.classList.add('pitch3dHeldScore');heldScore.inert=true;heldScore.setAttribute('aria-hidden','true');heldScore.querySelectorAll('[id]').forEach(el=>{const src=document.getElementById(el.id);if(src){const cs=getComputedStyle(src);for(const prop of ['position','left','right','top','bottom','width','height'])el.style[prop]=cs[prop]}el.removeAttribute('id')});score.after(heldScore)}}if(stage){stage.querySelector('.pitch3dCaption').classList.remove('show');stage.querySelector('.pitch3dCaption strong').textContent='투구 중…';stage.querySelector('.pitch3dCaption p').textContent='플레이가 이루어지는 순간 판정을 표시합니다.';}if(voice&&'speechSynthesis' in window)speechSynthesis.cancel();}
 function endHold(reveal=true,complete=true){document.body.classList.remove('pitchit3DPending');heldScore?.remove();heldScore=null;if(reveal&&pendingFeedback)originalFeedback(...pendingFeedback);pendingFeedback=null;if(complete){const panels=pendingPanels;pendingPanels=[];for(const show of panels)show();}}
 const originalFeedback=playFeedback;playFeedback=function(...args){if(enabled&&scene){pendingFeedback=args;return}return originalFeedback.apply(this,args)};
 const originalSummary=showGameSummary;showGameSummary=function(...args){if(document.body.classList.contains('pitchit3DPending')||(enabled&&scene&&scene.snapshot().phase!=='ready')){pendingPanels.push(()=>originalSummary.apply(this,args));return}return originalSummary.apply(this,args)};
 const originalBreak=showInningBreak;showInningBreak=function(...args){if(document.body.classList.contains('pitchit3DPending')||(enabled&&scene&&scene.snapshot().phase!=='ready')){pendingPanels.push(()=>originalBreak.apply(this,args));return}return originalBreak.apply(this,args)};
 const assetURL=new URL(location.pathname.includes('/game/')?'../3d/scene.js':'./3d/scene.js',location.href);
 const hasPick=()=>state.mode==='tutorial'||Number.isInteger(state.pick)&&state.pick>=0&&state.pick<25;
 const locked=()=>Boolean((enabled&&scene&&scene.snapshot().phase!=='ready')||state.finished||(state.net&&matchSubmitted)||document.getElementById('zone')?.classList.contains('choiceLocked'));
 function identities(){const defending=state.half==='bottom',attack=state.net?(state.visualAttackTeam||0):defending?1:0;return {batterId:'p'+(attack?2:1)+':batter:'+(defending?(state.awayTurn||0):(state.turn||0)),pitcherId:'p'+(attack?1:2)+':pitcher:'+(defending?(state.activePitcher||0):(state.awayActivePitcher||0))};}
 function model(){return{...identities(),mode:state.mode,attackTeam:state.net?(state.visualAttackTeam||0):state.half==='bottom'?1:0,pending:document.body.classList.contains('pitchit3DPending'),defending:state.half==='bottom',pick:state.pick,swing:state.swing,locked:locked(),rangeCells:[...document.querySelectorAll('#zone .range,#zone .contact-strong,#zone .contact-medium,#zone .contact-soft,#zone .power-range')].map(el=>Number(el.dataset.z)),rangeWeights:Object.fromEntries([...document.querySelectorAll('#zone [data-z]')].map(el=>[Number(el.dataset.z),el.classList.contains('contact-strong')?.8:el.classList.contains('contact-medium')?.55:el.classList.contains('contact-soft')?.3:el.classList.contains('power-range')?.8:0])),bases:[...(state.bases||[])],waiting:Boolean(state.net&&matchSubmitted),shop:typeof activeShop==='function'?activeShop():null}}
 function pick(cell){if(!enabled||locked())return;const button=document.querySelector(`#zone [data-z="${cell}"]`);if(button&&!button.disabled)button.click()}
 function status(text,meta={}){
  if(!stage)return;
  if(meta.reveal){endHold(true,false);scene?.sync(model());}
  if(meta.complete){endHold(true,true);sync();}
  if(meta.handedness)stage.querySelector('.pitch3dToolbar b').textContent='PITCHIT · '+meta.handedness.pitch+' / '+meta.handedness.bat;
  if(text)stage.querySelector('.pitch3dHint').textContent=text;
  if(meta.view)stage.querySelectorAll('[data-view3d]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view3d===meta.view)));
  if(meta.following)stage.querySelector('.pitch3dHint').textContent=(meta.fielding||'타구 추적 중');
  if(meta.commentary){const c=meta.commentary;const caption=stage.querySelector('.pitch3dCaption');caption.classList.add('show');clearTimeout(captionTimer);captionTimer=setTimeout(()=>caption.classList.remove('show'),2400);stage.querySelector('.pitch3dCaption small').textContent=c.pitch||'PITCHIT 경기 해설';stage.querySelector('.pitch3dCaption strong').textContent=c.title;stage.querySelector('.pitch3dCaption p').textContent=c.detail;
   if(voice&&'speechSynthesis' in window){speechSynthesis.cancel();const message=new SpeechSynthesisUtterance(c.title+' '+c.detail);message.lang='ko-KR';message.rate=1.08;const ko=speechSynthesis.getVoices().find(v=>v.lang.startsWith('ko'));if(ko)message.voice=ko;speechSynthesis.speak(message)}
  }
 }
 function sync(){buttons.forEach(button=>{button.textContent=enabled?'3D 모드 ON':'3D 모드';button.setAttribute('aria-pressed',String(enabled))});document.body.classList.toggle('pitchit3DEnabled',enabled);if(scene){scene.setActive(enabled&&Boolean(state.mode));scene.sync(model())}if(stage){stage.hidden=!enabled||!state.mode;historyPanel.hidden=true;syncControls();const playing=!stage.hidden;if(playing&&!wasPlaying&&innerWidth<=760)requestAnimationFrame(()=>stage.scrollIntoView({block:'start'}));wasPlaying=playing;const baitBar=stage.querySelector('.pitch3dBaits');baitBar.hidden=state.half!=='bottom'||!document.querySelector('.ballDirections button');baitBar.querySelectorAll('[data-bait3d]').forEach(button=>{const source=document.querySelector(`.ballDirections [data-ball="${button.dataset.bait3d}"],.ballDirections [data-tutorial-ball="${button.dataset.bait3d}"]`);button.disabled=locked()||!source||source.disabled;button.setAttribute('aria-pressed',String(Boolean(source?.classList.contains('on'))))})}}
 function ensureStage(){if(stage)return;const zone=document.querySelector('.zoneWrap');stage=document.createElement('section');stage.className='pitch3dViewport';stage.hidden=true;stage.innerHTML='<div class="pitch3dCanvas" aria-label="현재 PITCHIT 경기의 3D 장면"></div><nav class="pitch3dToolbar" aria-label="3D 카메라"><b>PITCHIT · 18.44m</b><button type="button" data-view3d="auto" aria-pressed="false">자동</button><button type="button" data-view3d="zone" aria-pressed="false">확대</button><button type="button" data-view3d="broadcast" aria-pressed="false">중계</button><button type="button" data-view3d="batter" aria-pressed="false">타자</button><button type="button" data-view3d="pitcher" aria-pressed="false">투수</button><button type="button" data-view3d="side" aria-pressed="false">측면</button></nav><small class="pitch3dHint">가상 스트라이크존의 칸을 직접 선택하세요.</small><div class="pitch3dExtras"><button type="button" data-follow3d>타구 추적</button><button type="button" data-voice3d aria-pressed="false">음성 해설 OFF</button></div><div class="pitch3dBaits" aria-label="유인구 선택" hidden><button type="button" data-bait3d="high">높은 공</button><button type="button" data-bait3d="low">낮은 공</button><button type="button" data-bait3d="in">몸쪽</button><button type="button" data-bait3d="out">바깥쪽</button></div><section class="pitch3dCaption" role="log" aria-live="polite" aria-atomic="true"><small>PITCHIT 경기 해설</small><strong>어떤 코스로 승부할까요?</strong><p>스윙 유형이나 구종을 고른 뒤, 타석 앞의 가상 스트라이크존을 클릭하세요.</p></section>';zone.before(stage);
  const legend=document.createElement('div');legend.className='pitch3dLegend';legend.innerHTML='<span class="aim">◆ 선택</span><span class="range">청록 → 보라: 타격 범위 강 → 약</span><span class="actual">⊕ 실제 투구</span>';stage.append(legend);legend.innerHTML='<span class="aim">◆ 선택</span><span class="range">청록: 최근 타격</span><span class="actual">① 최근 공 · ⑤ 이전 공</span>';const controls=document.createElement('div');controls.className='pitch3dControls';controls.innerHTML='<div class="pitch3dChoices"></div><button type="button" class="pitch3dConfirm">선택 완료</button>';controls.querySelector('button').onclick=()=>{if(hasPick())document.getElementById('swing')?.click()};stage.append(controls);
  historyPanel=document.createElement('section');historyPanel.className='pitch3dHistory';historyPanel.hidden=true;historyPanel.setAttribute('aria-label','최근 투구 위치 기록');historyPanel.hidden=true;
  stage.querySelectorAll('[data-view3d]').forEach(button=>button.onclick=()=>{scene?.setCamera(button.dataset.view3d);if(button.dataset.view3d==='zone')status(locked()?'선택 완료 · 다음 차례를 기다립니다.':'가상 스트라이크존에서 코스를 선택하세요.')});
  stage.querySelectorAll('[data-bait3d]').forEach(button=>button.onclick=()=>{if(locked())return;document.querySelector(`.ballDirections [data-ball="${button.dataset.bait3d}"],.ballDirections [data-tutorial-ball="${button.dataset.bait3d}"]`)?.click()});
  const followButton=stage.querySelector('[data-follow3d]');function followLabel(){followButton.textContent='타구 추적 '+(follow?'ON':'OFF');followButton.setAttribute('aria-pressed',String(follow))}followLabel();followButton.onclick=()=>{follow=!follow;scene?.setFollow(follow);followLabel()};
  const voiceButton=stage.querySelector('[data-voice3d]');voiceButton.disabled=!('speechSynthesis' in window);if(voiceButton.disabled)voiceButton.textContent='음성 미지원';voiceButton.onclick=()=>{voice=!voice;voiceButton.textContent='음성 해설 '+(voice?'ON':'OFF');voiceButton.setAttribute('aria-pressed',String(voice));if(!voice)speechSynthesis.cancel()};
 }
 function syncControls(){if(!stage)return;const choices=stage.querySelector('.pitch3dChoices');if(!choices)return;choices.replaceChildren();document.querySelectorAll('#types button').forEach(source=>{const b=document.createElement('button');b.type='button';b.textContent=source.textContent;b.className=source.className;b.disabled=source.disabled||locked();b.onclick=()=>source.click();choices.append(b)});const original=document.getElementById('swing'),confirm=stage.querySelector('.pitch3dConfirm');confirm.textContent=original?.textContent||'선택 완료';confirm.disabled=!original||original.disabled||locked()||!hasPick();}
 setInterval(()=>{if(enabled&&stage&&!stage.hidden){const original=document.getElementById('swing'),confirm=stage.querySelector('.pitch3dConfirm');if(confirm&&original){confirm.textContent=original.textContent;confirm.disabled=original.disabled||locked()||!hasPick()}}},250);
 async function toggle(){enabled=!enabled;loadVersion++;const version=loadVersion;ensureStage();sync();if(!enabled)endHold(false);if(!enabled&&voice&&'speechSynthesis' in window)speechSynthesis.cancel();
  if(enabled&&!scene){try{loading??=import(assetURL.href);const module=await loading;if(!enabled||version!==loadVersion)return;stage.hidden=false;scene=module.createPitchitScene(stage.querySelector('.pitch3dCanvas'),status,pick);scene.setFollow(follow);sync();}catch(error){enabled=false;loading=null;sync();notice.textContent='3D를 불러오지 못했습니다. 기존 2D 화면으로 계속 플레이할 수 있습니다.';console.warn('PITCHIT 3D unavailable',error);return}}
  if(enabled&&latestRoomHistory)scene?.restoreHistory(latestRoomHistory);
  notice.textContent=enabled&&!state.mode?'3D 화면이 켜졌습니다. 기존 싱글 플레이·빠른 대전·친구 대전 중에서 선택하세요.':'';
 }
 const notice=document.createElement('p');notice.className='pitch3dNotice';document.querySelector('.homeGuideActions')?.after(notice);
 for(const selector of ['.homeGuideActions','.game .top']){const mount=document.querySelector(selector);if(!mount)continue;const button=document.createElement('button');button.type='button';button.className='demo3DEntry';button.setAttribute('aria-pressed','false');button.textContent='3D 모드';button.onclick=toggle;mount.append(button);buttons.push(button)}
 document.getElementById('swing')?.addEventListener('click',event=>{if(!hasPick()){event.preventDefault();event.stopImmediatePropagation();}},true);
 function captureLocalPlay(){localPresentation={...identities(),basesBefore:[...(state.bases||[])],defending:state.half==='bottom',attacker:state.half==='bottom'?'p2':'p1',batCell:state.half==='bottom'?state.opponentLastCell:state.pick};if(!state.net)beginHold();}
 const originalBat=bat;bat=function(...args){if(!hasPick()||locked())return;captureLocalPlay();return originalBat.apply(this,args)};const originalPitch=pitch;pitch=function(...args){if(!hasPick()||locked())return;captureLocalPlay();return originalPitch.apply(this,args)};
 const originalStart=start;start=function(...args){lastNetworkKey='';latestRoomHistory=null;pendingPanels=[];endHold(false);scene?.reset();return originalStart.apply(this,args)};
 const originalRender=render;render=function(...args){const value=originalRender.apply(this,args);const action=document.getElementById('swing');if(action&&state.mode&&!state.net&&state.mode!=='tutorial'){action.disabled=!hasPick()||state.finished;action.classList.toggle('waiting',action.disabled);if(!hasPick())action.textContent='먼저 코스를 선택하세요';}sync();return value};
 const originalApply=applyMatch;applyMatch=function(data){const incoming=data?.game,ip=incoming?.lastPlay,ik=ip?JSON.stringify([matchSession?.code,incoming.deadline,incoming.event,ip]):'';if(ik&&ik!==lastNetworkKey&&!state.suppressLastPlayDisplay)beginHold();state.visualAttackTeam=incoming?.half||0;const value=originalApply.apply(this,arguments);const g=data?.game,play=g?.lastPlay;if(play&&!state.suppressLastPlayDisplay){const key=JSON.stringify([matchSession?.code,g.deadline,g.event,play]);if(key!==lastNetworkKey){lastNetworkKey=key;if(enabled&&scene)scene.play({...play,key,variationKey:JSON.stringify([matchSession?.code,g.deadline,play]),actualCell:play.actualCell,batCell:play.bat?.cell,swing:play.bat?.swing,pitchName:play.pitchName,speed:play.speed,outcome:play.outcome||g.playLog?.[0]?.outcome,strikeStyle:play.strikeStyle,isBall:play.isBall,execution:play.execution,direction:play.pitch?.ball,text:g.event})}}return value};
 const originalSetResult=setResult;setResult=function(text,kind){const visual={basesBefore:scene?.snapshot().bases,basesAfter:[...(state.bases||[])],actualCell:state.ball,batCell:state.half==='top'?state.pick:state.opponentLastCell,pitchName:state.pitchType==='breaking'?'변화구':'패스트볼',text,outcome:kind,...(localPresentation||{}),...(state.localGroundVisual||{})};state.localGroundVisual=null;localPresentation=null;if(!state.net&&state.mode)beginHold();const value=originalSetResult.apply(this,arguments);if(enabled&&scene&&!state.net&&state.mode)scene.play({...visual,speed:Number(String(state.lastPitchInfo||'').match(/(\d+)\s*km/)?.[1])||140,key:`local:${++localSequence}`});return value};
 window.pitchit3D={snapshot:()=>({enabled,scene:scene?.snapshot()||null})};
 const adoptedRooms=new Set();
 const originalRequest=requestMatch;requestMatch=async function(input){
  const entry=['create','join','quick','solo'].includes(input?.action);
  const data=await originalRequest.call(this,entry?{...input,graphics3D:enabled}:input);
  if(Array.isArray(data?.game?.history))latestRoomHistory=data.game.history;
  if(data?.graphics3D===true&&data.code&&!adoptedRooms.has(data.code)){
   adoptedRooms.add(data.code);if(!enabled)await toggle();scene?.setRoomSeed(data.code);
   if(enabled)notice.textContent='참가자의 3D 설정에 따라 이 경기는 3D로 시작합니다.';
  }
  return data;
 };
 sync();
})();
</script>
